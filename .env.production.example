# Syntax-check template only. Do not use these values in production.
POSTGRES_DB=smarthome
POSTGRES_USER=smarthome_owner
POSTGRES_PASSWORD=replace-with-a-long-random-secret
APP_DB_PASSWORD=replace-with-a-different-random-secret
IOT_DB_PASSWORD=replace-with-a-third-random-secret
DATABASE_URL=postgresql://smarthome_app_login:replace-me@postgres:5432/smarthome
DATABASE_IOT_URL=postgresql://smarthome_ingest_login:replace-me@postgres:5432/smarthome
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-secret
CORS_ALLOWED_ORIGINS=https://smarthome.example.com
FRONTEND_URL=https://smarthome.example.com
COOKIE_SAME_SITE=lax
MQTT_BROKER_URL=mqtts://broker.example.com:8883
MQTT_USERNAME=replace-me
MQTT_PASSWORD=replace-me
MQTT_CLIENT_ID=smarthome-backend-production
MQTT_STATUS_CLIENT_ID=smarthome-backend-status-production
MQTT_TOPIC_NAMESPACE=smarthome/production/v1
MQTT_TLS_CA_FILE=
TRUSTED_PROXY_CIDRS=
BACKUP_RETENTION_DAYS=30
